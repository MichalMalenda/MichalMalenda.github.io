@page "/tictactoe"
@using System.Linq
<BackButton />
<title>Tic Tac Toe</title>

<h1 @onclick="ToggleDescription" style="cursor: pointer; font-family: Consolas;">
    Tic Tac Toe
</h1>

@if (!showDescription)
{
    <div class="main_container">
        <div class="game_container">
            <div class="game_mode_selector">
                <button class="mode_button @(isAIMode ? "active" : "")" @onclick="() => SetGameMode(true)">
                    vs AI
                </button>
                <button class="mode_button @(!isAIMode ? "active" : "")" @onclick="() => SetGameMode(false)">
                    Two Player
                </button>
            </div>

            <div class="score_board">
                <div class="score">
                    <div class="score_label">@(isAIMode ? "You (X)" : "Player X")</div>
                    <div class="score_value x_score">@scores.X</div>
                </div>
                <div class="score">
                    <div class="score_label">Ties</div>
                    <div class="score_value">@scores.Tie</div>
                </div>
                <div class="score">
                    <div class="score_label">@(isAIMode ? "AI (O)" : "Player O")</div>
                    <div class="score_value o_score">@scores.O</div>
                </div>
            </div>

            <div class="game_info">
                @if (!string.IsNullOrEmpty(winner))
                {
                    @if (winner == "Tie")
                    {
                        <span>Game ended in a tie!</span>
                    }
                    else if (isAIMode)
                    {
                        @if (winner == "X")
                        {
                            <span>You Win! <span class="winner_x">X</span></span>
                        }
                        else
                        {
                            <span>AI Wins! <span class="winner_o">O</span></span>
                        }
                    }
                    else
                    {
                        <span>Winner: <span class="winner_@winner.ToLower()">@winner</span></span>
                    }
                }
                else if (isAIMode && isProcessingMove && currentPlayer == "O")
                {
                    <span>AI is thinking...</span>
                }
                else if (isAIMode)
                {
                    <span>Your turn: <span class="current_player">X</span></span>
                }
                else
                {
                    <span>Current Player: <span class="current_player">@currentPlayer</span></span>
                }
            </div>

            <div class="game_board">
                @for (int i = 0; i < 9; i++)
                {
                    int index = i; // Capture for lambda
                                   <button class="cell @(gameBoard[i] != "" ? "taken" : "") @(gameBoard[i].ToLower())"
                                           @onclick="() => MakeMove(index)"
                                           disabled="@(!gameActive || gameBoard[i] != "" || (isAIMode && isProcessingMove))">
                                       @gameBoard[i]
                                   </button>
                }
            </div>

            <div class="button_wrapper">
                <button @onclick="ResetGame">New Game</button>
                <button @onclick="ResetScore">Reset Score</button>
            </div>
        </div>
    </div>
}

@if (showDescription)
{
    <div class="description_container">
        Tic Tac Toe is now a single-player game where you can play against an AI opponent or with a friend. Choose your game mode using the buttons above the game board.
        <br />
        <br />
        <strong>AI Mode:</strong>
        <br />• You (X) always go first
        <br />• Click on any empty cell to place your X
        <br />• The AI will automatically respond with its O move
        <br />• Try to get three X's in a row while the AI tries to stop you
        <br />
        <br />
        <strong>Two Player Mode:</strong>
        <br />• Players alternate turns (X then O)
        <br />• Click on any empty cell to place your mark
        <br />• Try to get three in a row while blocking your opponent
        <br />
        <br />
        The AI uses smart strategy - it will try to win if it can, block you if you're about to win, and otherwise make strategic moves. This creates a challenging single-player experience!
        <br />
        <br />
    </div>
}

@code {
    private bool showDescription = false;
    private string[] gameBoard = new string[9];
    private string currentPlayer = "X";
    private bool gameActive = true;
    private string winner = "";
    private GameScores scores = new GameScores();
    private bool isProcessingMove = false;
    private bool isAIMode = true; // Default to AI mode

    private readonly int[,] winningConditions = new int[,]
    {
        {0, 1, 2}, {3, 4, 5}, {6, 7, 8}, // Rows
        {0, 3, 6}, {1, 4, 7}, {2, 5, 8}, // Columns
        {0, 4, 8}, {2, 4, 6}             // Diagonals
    };

    protected override void OnInitialized()
    {
        InitializeGame();
    }

    private void ToggleDescription()
    {
        showDescription = !showDescription;
    }

    private void InitializeGame()
    {
        gameBoard = new string[9];
        for (int i = 0; i < 9; i++)
        {
            gameBoard[i] = "";
        }
        currentPlayer = "X";
        gameActive = true;
        winner = "";
    }

    private async void MakeMove(int cellIndex)
    {
        if (gameBoard[cellIndex] != "" || !gameActive || (isAIMode && isProcessingMove))
        {
            return;
        }

        if (isAIMode)
        {
            isProcessingMove = true;
        }

        // Player move
        gameBoard[cellIndex] = currentPlayer;

        if (CheckWinner())
        {
            winner = currentPlayer;
            if (currentPlayer == "X")
                scores.X++;
            else
                scores.O++;
            gameActive = false;
            if (isAIMode) isProcessingMove = false;
            StateHasChanged();
            return;
        }

        if (IsBoardFull())
        {
            winner = "Tie";
            scores.Tie++;
            gameActive = false;
            if (isAIMode) isProcessingMove = false;
            StateHasChanged();
            return;
        }

        if (isAIMode && currentPlayer == "X")
        {
            currentPlayer = "O";
            StateHasChanged();

            // AI move after short delay
            await Task.Delay(500);

            if (gameActive)
            {
                int aiMove = GetBestMove();
                if (aiMove != -1)
                {
                    gameBoard[aiMove] = currentPlayer;

                    if (CheckWinner())
                    {
                        winner = currentPlayer;
                        scores.O++;
                        gameActive = false;
                    }
                    else if (IsBoardFull())
                    {
                        winner = "Tie";
                        scores.Tie++;
                        gameActive = false;
                    }
                    else
                    {
                        currentPlayer = "X";
                    }
                }
            }

            isProcessingMove = false;
            StateHasChanged();
        }
        else if (!isAIMode)
        {
            // Two player mode - just switch turns
            currentPlayer = currentPlayer == "X" ? "O" : "X";
            StateHasChanged();
        }
    }

    private bool CheckWinner()
    {
        for (int i = 0; i < winningConditions.GetLength(0); i++)
        {
            int pos1 = winningConditions[i, 0];
            int pos2 = winningConditions[i, 1];
            int pos3 = winningConditions[i, 2];

            if (gameBoard[pos1] == currentPlayer &&
                gameBoard[pos2] == currentPlayer &&
                gameBoard[pos3] == currentPlayer)
            {
                return true;
            }
        }
        return false;
    }

    private bool IsBoardFull()
    {
        for (int i = 0; i < 9; i++)
        {
            if (gameBoard[i] == "")
                return false;
        }
        return true;
    }

    private void SetGameMode(bool aiMode)
    {
        isAIMode = aiMode;
        ResetGame();
    }

    private void ResetGame()
    {
        InitializeGame();
        StateHasChanged();
    }

    private void ResetScore()
    {
        scores = new GameScores();
        StateHasChanged();
    }

    private int GetBestMove()
    {
        // 1. Check if AI can win
        for (int i = 0; i < 9; i++)
        {
            if (gameBoard[i] == "")
            {
                gameBoard[i] = "O";
                if (CheckWinner())
                {
                    gameBoard[i] = "";
                    return i;
                }
                gameBoard[i] = "";
            }
        }

        // 2. Check if AI needs to block player from winning
        for (int i = 0; i < 9; i++)
        {
            if (gameBoard[i] == "")
            {
                gameBoard[i] = "X";
                if (CheckWinnerForPlayer("X"))
                {
                    gameBoard[i] = "";
                    return i;
                }
                gameBoard[i] = "";
            }
        }

        // 3. Take center if available
        if (gameBoard[4] == "")
        {
            return 4;
        }

        // 4. Take corners
        int[] corners = { 0, 2, 6, 8 };
        var availableCorners = corners.Where(i => gameBoard[i] == "").ToList();
        if (availableCorners.Any())
        {
            return availableCorners[new Random().Next(availableCorners.Count)];
        }

        // 5. Take any available side
        int[] sides = { 1, 3, 5, 7 };
        var availableSides = sides.Where(i => gameBoard[i] == "").ToList();
        if (availableSides.Any())
        {
            return availableSides[new Random().Next(availableSides.Count)];
        }

        return -1;
    }

    private bool CheckWinnerForPlayer(string player)
    {
        for (int i = 0; i < winningConditions.GetLength(0); i++)
        {
            int pos1 = winningConditions[i, 0];
            int pos2 = winningConditions[i, 1];
            int pos3 = winningConditions[i, 2];

            if (gameBoard[pos1] == player &&
                gameBoard[pos2] == player &&
                gameBoard[pos3] == player)
            {
                return true;
            }
        }
        return false;
    }

    public class GameScores
    {
        public int X { get; set; } = 0;
        public int O { get; set; } = 0;
        public int Tie { get; set; } = 0;
    }
}