@inject NavigationManager Navigation
<button class="back-button" @onclick="GoBack" style="display: flex; gap: 10px;">
    @ButtonText
</button>

@code {
    [Parameter] public string? BackUrl { get; set; } = "/";
    [Parameter] public string ButtonText { get; set; } = "";

    private void GoBack()
    {
        Navigation.NavigateTo(BackUrl!, true);
    }
}