@page "/dlens-to-moxfield"
@using System.IO
@using System.Linq
@using System.Collections.Generic
@using System.Text
@using System.Text.Json.Serialization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IDisposable
<BackButton />

<h1 style="cursor: pointer;font-family:Consolas;" @onclick="ToggleDescription">Delver Lens &rarr; Moxfield</h1>

<div class="left_display">
    @if (showDescription)
    {
        <div class="sticky_left">
            <p>Converts a Delver Lens <code>.dlens</code> file into a CSV file formatted for Moxfield's collection importer. Everything happens in your browser — the file is never uploaded anywhere.</p>
            <p><strong>How to use:</strong></p>
            <ul>
                <li>In Delver Lens: menu &rarr; <em>Create Backup File</em> &rarr; select "keep images" &rarr; tap <strong>Download</strong>. This produces a <code>&lt;date&gt;_backup.dlens</code> file that includes the full card database, so every card resolves without needing internet.</li>
                <li>Upload that file below.</li>
                <li>Pick a list (or "All lists"), click <strong>Generate CSV</strong>, then import the downloaded file on Moxfield under <em>Collection &rarr; Import</em>.</li>
            </ul>
            <p><strong>Note on plain exports:</strong> if you upload a <code>&lt;date&gt;_exported.dlens</code> file (created without tapping Download), it does <em>not</em> contain the card-name database. Only cards that happen to carry a Scryfall ID can be resolved automatically at first; the rest can usually still be recovered with the OCR step below, since these files also carry a scanned photo per card.</p>
            <p><strong>OCR step:</strong> for cards that don't resolve on upload, click <strong>Try OCR on unresolved card photos</strong>. This loads Tesseract.js (a client-side OCR engine, ~2MB, only fetched when you click it) and reads each card's embedded photo, looking for its printed collector number/set code and, failing that, its title. Every OCR result is either matched by an unambiguous collector-number lookup or shown to you as a suggestion to confirm — nothing is applied silently. Blurry or glare-heavy photos may still need a manual name typed in.</p>
        </div>
    }
    else
    {
        <div class="upload-section">
            <p class="color-text">Select a <code>.dlens</code> file exported from Delver Lens:</p>
            <InputFile OnChange="OnFileSelected" accept=".dlens" />

            @if (isProcessing)
            {
                <p class="color-text" style="margin-top:15px;">@statusMessage</p>
            }

            @if (parseError != null)
            {
                <p id="error">@parseError</p>
            }

            @if (parsedLists != null && !isProcessing)
            {
                <div class="stats-section">
                    <div class="stat-item">
                        <span class="color-text">File type</span>
                        <span class="stat-value" style="font-size:1rem;">@(hasFullCardData ? "Full backup" : "Plain export")</span>
                    </div>
                    <div class="stat-item">
                        <span class="color-text">Resolved</span>
                        <span class="stat-value">@resolvedCount / @totalCount</span>
                    </div>
                    @if (unresolvedCards.Count > 0)
                    {
                        <div class="stat-item">
                            <span class="color-text">Unresolved</span>
                            <span class="stat-value" style="color:darkred;">@unresolvedCards.Count</span>
                        </div>
                    }
                </div>

                <div class="setting-group">
                    <span class="setting-label color-text">List:</span>
                    <select @bind="selectedListId" class="text_box_in" style="width:220px;">
                        <option value="-1">All lists (@totalCount cards)</option>
                        @foreach (var l in parsedLists)
                        {
                            <option value="@l.Id">@l.Name</option>
                        }
                    </select>
                </div>

                <div style="margin-top:15px;">
                    <button @onclick="GenerateCsv" disabled="@(resolvedCount == 0)">Generate CSV</button>
                    @if (unresolvedCards.Count > 0)
                    {
                        <button @onclick="GenerateUnresolvedCsv">Export unresolved list</button>
                    }
                </div>

                @if (unresolvedCardsWithImages > 0)
                {
                    <div style="margin-top:15px;">
                        <button @onclick="RunOcr" disabled="@isOcrProcessing">
                            @(isOcrProcessing ? "Running OCR..." : $"Try OCR on {unresolvedCardsWithImages} unresolved card photo(s)")
                        </button>
                        <p class="color-text" style="font-size:0.85rem;max-width:600px;margin:6px auto;">
                            Reads the collector number / card name off each unresolved card's scanned photo (client-side, via Tesseract.js) and looks the result up on Scryfall. Nothing here is added to your export without your confirmation.
                        </p>
                    </div>
                }

                @if (isOcrProcessing)
                {
                    <p class="color-text">@ocrStatusMessage</p>
                }

                @if (ocrReviewItems.Count > 0)
                {
                    <div class="sticky_left" style="margin-top:15px;">
                        <p class="color-text"><strong>OCR suggestions &mdash; please confirm each one:</strong></p>
                        @foreach (var item in ocrReviewItems)
                        {
                            <div class="setting-group" style="border:1px solid #333;border-radius:10px;padding:10px;">
                                @if (item.Result.ImageDataUrl != null)
                                {
                                    <img src="@item.Result.ImageDataUrl" style="width:70px;border-radius:6px;" alt="scanned card" />
                                }
                                <span class="color-text">
                                    Guess: <strong>@item.Result.Name</strong> (@item.Result.Set @item.Result.CollectorNumber)
                                    @if (!string.IsNullOrEmpty(item.Result.OcrNameGuess))
                                    {
                                        <text><br />OCR read: "@item.Result.OcrNameGuess"</text>
                                    }
                                </span>
                                <button @onclick="() => AcceptSuggestion(item)">Accept</button>
                                <button @onclick="() => RejectSuggestion(item)">Not this</button>
                            </div>
                        }
                    </div>
                }

                @if (ocrManualItems.Count > 0)
                {
                    <div class="sticky_left" style="margin-top:15px;">
                        <p class="color-text"><strong>Couldn't auto-match &mdash; type the card name to look it up:</strong></p>
                        @foreach (var item in ocrManualItems)
                        {
                            <div class="setting-group" style="border:1px solid #333;border-radius:10px;padding:10px;">
                                @if (item.Result.ImageDataUrl != null)
                                {
                                    <img src="@item.Result.ImageDataUrl" style="width:70px;border-radius:6px;" alt="scanned card" />
                                }
                                <input type="text" @bind="item.ManualNameInput" placeholder="Card name" style="width:180px;" />
                                <button @onclick="() => ManualLookup(item)">Look up</button>
                                @if (!string.IsNullOrEmpty(item.LookupError))
                                {
                                    <span id="error">@item.LookupError</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (unresolvedCards.Count > 0)
                {
                    <div class="sticky_left" style="margin-top:15px;">
                        <p id="error">@unresolvedCards.Count card(s) still couldn't be matched and are skipped from the Moxfield CSV:</p>
                        <ul>
                            @foreach (var c in unresolvedCards.Take(50))
                            {
                                <li class="color-text">
                                    internal id @c.Card &mdash; qty @c.Quantity &mdash; list "@GetListName(c.List)"
                                    @if (!string.IsNullOrWhiteSpace(c.Note))
                                    {
                                        <text> &mdash; note: @c.Note</text>
                                    }
                                </li>
                            }
                        </ul>
                        @if (unresolvedCards.Count > 50)
                        {
                            <p class="color-text">...and @(unresolvedCards.Count - 50) more (full list in the exported CSV button above).</p>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private bool showDescription = false;
    private void ToggleDescription() => showDescription = !showDescription;

    private bool isProcessing = false;
    private string statusMessage = "";
    private string? parseError = null;

    private bool hasFullCardData = false;
    private List<DlensList>? parsedLists = null;
    private List<DlensCard> allCards = new();
    private List<DlensCard> unresolvedCards = new();

    private int totalCount = 0;
    private int resolvedCount = 0;
    private int selectedListId = -1;
    private int unresolvedCardsWithImages = 0;

    private bool isOcrProcessing = false;
    private string ocrStatusMessage = "";
    private List<OcrReviewItem> ocrReviewItems = new();
    private List<OcrReviewItem> ocrManualItems = new();
    private DotNetObjectReference<DlensToMoxfield>? dotNetRef;

    private static readonly Dictionary<string, string> ConditionMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["NM"] = "Near Mint",
        ["Near Mint"] = "Near Mint",
        ["Mint"] = "Mint",
        ["M"] = "Mint",
        ["LP"] = "Lightly Played",
        ["Lightly Played"] = "Lightly Played",
        ["MP"] = "Moderately Played",
        ["Moderately Played"] = "Moderately Played",
        ["HP"] = "Heavily Played",
        ["Heavily Played"] = "Heavily Played",
        ["DMG"] = "Damaged",
        ["Damaged"] = "Damaged",
        ["Poor"] = "Damaged",
    };

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        parseError = null;
        parsedLists = null;
        allCards = new();
        unresolvedCards = new();
        ocrReviewItems = new();
        ocrManualItems = new();
        isProcessing = true;
        statusMessage = "Reading file...";
        StateHasChanged();

        try
        {
            var file = e.File;
            const long maxSize = 40_000_000; // 40 MB, .dlens files can carry embedded card images
            if (file.Size > maxSize)
            {
                parseError = $"That file is {file.Size / 1_000_000} MB, which is larger than this tool supports ({maxSize / 1_000_000} MB).";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            statusMessage = "Opening database...";
            StateHasChanged();

            var result = await JSRuntime.InvokeAsync<DlensParseResult>("dlensConverter.parseDatabase", bytes);

            hasFullCardData = result.HasFullCardData;
            parsedLists = result.Lists;
            allCards = result.Cards;
            totalCount = allCards.Count;

            statusMessage = hasFullCardData
                ? "Resolving cards from the embedded card database..."
                : "Resolving cards against Scryfall (only cards with a saved Scryfall ID can be matched)...";
            StateHasChanged();

            await ResolveCardsAsync();

            if (totalCount == 0)
            {
                parseError = "No cards were found in this file.";
            }
        }
        catch (Exception ex)
        {
            parseError = $"Couldn't read that file — is it a valid Delver Lens .dlens export? ({ex.Message})";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ResolveCardsAsync()
    {
        resolvedCount = 0;
        unresolvedCards = new();

        // Cards not already resolved locally, but that carry a scryfall id, get looked up via Scryfall.
        var idsToFetch = allCards
            .Where(c => string.IsNullOrEmpty(c.ResolvedName) && !string.IsNullOrEmpty(c.ResolvedScryfallId))
            .Select(c => c.ResolvedScryfallId)
            .Distinct()
            .ToList();

        var scryfallInfo = new Dictionary<string, ScryfallCard>();

        for (int i = 0; i < idsToFetch.Count; i += 75)
        {
            var batch = idsToFetch.Skip(i).Take(75).ToList();
            var payload = new ScryfallCollectionRequest
            {
                Identifiers = batch.Select(id => new ScryfallIdentifier { Id = id }).ToList()
            };

            try
            {
                var response = await Http.PostAsJsonAsync("https://api.scryfall.com/cards/collection", payload);
                if (response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadFromJsonAsync<ScryfallCollectionResponse>();
                    if (body?.Data != null)
                    {
                        foreach (var card in body.Data)
                        {
                            scryfallInfo[card.Id] = card;
                        }
                    }
                }
            }
            catch
            {
                // Network or CORS hiccup — cards in this batch simply stay unresolved.
            }
        }

        foreach (var c in allCards)
        {
            if (!string.IsNullOrEmpty(c.ResolvedName))
            {
                resolvedCount++;
                continue;
            }

            if (!string.IsNullOrEmpty(c.ResolvedScryfallId) && scryfallInfo.TryGetValue(c.ResolvedScryfallId, out var info))
            {
                c.ResolvedName = info.Name;
                c.ResolvedEdition = info.Set;
                c.ResolvedNumber = info.CollectorNumber;
                resolvedCount++;
                continue;
            }

            unresolvedCards.Add(c);
        }

        unresolvedCardsWithImages = unresolvedCards.Count(c => c.HasImage);
    }

    private void RecomputeResolution()
    {
        resolvedCount = allCards.Count(c => !string.IsNullOrEmpty(c.ResolvedName));
        unresolvedCards = allCards.Where(c => string.IsNullOrEmpty(c.ResolvedName)).ToList();
        unresolvedCardsWithImages = unresolvedCards.Count(c => c.HasImage);
    }

    private async Task RunOcr()
    {
        isOcrProcessing = true;
        ocrStatusMessage = "Starting OCR (loading the OCR engine, this can take a moment on first run)...";
        ocrReviewItems = new();
        ocrManualItems = new();
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);

        var idsToOcr = unresolvedCards.Where(c => c.HasImage).Select(c => c.Id).ToList();

        try
        {
            var results = await JSRuntime.InvokeAsync<List<OcrResult>>("dlensConverter.ocrResolveCards", idsToOcr, dotNetRef);

            foreach (var r in results)
            {
                var card = allCards.FirstOrDefault(c => c.Id == r.CardId);
                if (card == null) continue;

                if (r.Status == "matched-collector")
                {
                    // Collector number + set code is an unambiguous lookup key, so this is applied directly.
                    card.ResolvedName = r.Name ?? "";
                    card.ResolvedEdition = r.Set ?? "";
                    card.ResolvedNumber = r.CollectorNumber ?? "";
                    card.ResolvedScryfallId = r.ScryfallId ?? "";
                }
                else if (r.Status == "suggested-name")
                {
                    ocrReviewItems.Add(new OcrReviewItem { Result = r, Card = card });
                }
                else
                {
                    ocrManualItems.Add(new OcrReviewItem { Result = r, Card = card });
                }
            }

            RecomputeResolution();
        }
        catch (Exception ex)
        {
            parseError = $"OCR step failed: {ex.Message}";
        }
        finally
        {
            isOcrProcessing = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnOcrProgress(int current, int total)
    {
        ocrStatusMessage = $"Running OCR on card photos... {current}/{total}";
        StateHasChanged();
    }

    private void AcceptSuggestion(OcrReviewItem item)
    {
        item.Card.ResolvedName = item.Result.Name ?? "";
        item.Card.ResolvedEdition = item.Result.Set ?? "";
        item.Card.ResolvedNumber = item.Result.CollectorNumber ?? "";
        item.Card.ResolvedScryfallId = item.Result.ScryfallId ?? "";
        ocrReviewItems.Remove(item);
        RecomputeResolution();
    }

    private void RejectSuggestion(OcrReviewItem item)
    {
        ocrReviewItems.Remove(item);
        item.Result.Status = "unmatched";
        ocrManualItems.Add(item);
    }

    private async Task ManualLookup(OcrReviewItem item)
    {
        item.LookupError = null;
        if (string.IsNullOrWhiteSpace(item.ManualNameInput))
        {
            item.LookupError = "Type a card name first.";
            return;
        }

        var found = await JSRuntime.InvokeAsync<ScryfallLookupResult?>("dlensConverter.lookupCardByName", item.ManualNameInput);
        if (found != null)
        {
            item.Result.Name = found.Name;
            item.Result.Set = found.Set;
            item.Result.CollectorNumber = found.CollectorNumber;
            item.Result.ScryfallId = found.ScryfallId;
            item.Result.Status = "suggested-name";
            ocrManualItems.Remove(item);
            ocrReviewItems.Add(item);
        }
        else
        {
            item.LookupError = "No match found on Scryfall for that name.";
        }
    }

    private string GetListName(int listId) =>
        parsedLists?.FirstOrDefault(l => l.Id == listId)?.Name ?? $"list #{listId}";

    private string MapCondition(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "Near Mint";
        return ConditionMap.TryGetValue(raw.Trim(), out var mapped) ? mapped : "Near Mint";
    }

    private async Task GenerateCsv()
    {
        IEnumerable<DlensCard> cardsToExport = allCards.Where(c => !string.IsNullOrEmpty(c.ResolvedName));
        if (selectedListId != -1)
        {
            cardsToExport = cardsToExport.Where(c => c.List == selectedListId);
        }

        var sb = new StringBuilder();
        sb.Append("Count,Name,Edition,Condition,Language,Foil,Collector Number,Tag\r\n");

        foreach (var c in cardsToExport)
        {
            var language = string.IsNullOrWhiteSpace(c.Language) ? "English" : c.Language;
            var foil = c.Foil != 0 ? "foil" : "";
            var tag = GetListName(c.List);

            sb.Append(string.Join(",",
                CsvEscape(c.Quantity.ToString()),
                CsvEscape(c.ResolvedName),
                CsvEscape(c.ResolvedEdition),
                CsvEscape(MapCondition(c.Condition)),
                CsvEscape(language),
                CsvEscape(foil),
                CsvEscape(c.ResolvedNumber),
                CsvEscape(tag)));
            sb.Append("\r\n");
        }

        var listLabel = selectedListId == -1 ? "all" : GetListName(selectedListId).Replace(' ', '_');
        await JSRuntime.InvokeVoidAsync("dlensConverter.downloadFile", $"moxfield_import_{listLabel}.csv", sb.ToString());
    }

    private async Task GenerateUnresolvedCsv()
    {
        var sb = new StringBuilder();
        sb.Append("Internal Card Id,Quantity,List,Note,Condition,Language\r\n");

        foreach (var c in unresolvedCards)
        {
            sb.Append(string.Join(",",
                CsvEscape(c.Card.ToString()),
                CsvEscape(c.Quantity.ToString()),
                CsvEscape(GetListName(c.List)),
                CsvEscape(c.Note),
                CsvEscape(c.Condition),
                CsvEscape(c.Language)));
            sb.Append("\r\n");
        }

        await JSRuntime.InvokeVoidAsync("dlensConverter.downloadFile", "unresolved_cards.csv", sb.ToString());
    }

    private string CsvEscape(string? value)
    {
        value ??= "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
        {
            value = "\"" + value.Replace("\"", "\"\"") + "\"";
        }
        return value;
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    // ---- Models matching the JSON shape returned by wwwroot/js/dlensConverter.js ----

    private class DlensParseResult
    {
        public bool HasFullCardData { get; set; }
        public List<DlensList> Lists { get; set; } = new();
        public List<DlensCard> Cards { get; set; } = new();
        public int ImageCount { get; set; }
    }

    private class DlensList
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    private class DlensCard
    {
        public int Id { get; set; }
        public int Card { get; set; }
        public int Foil { get; set; }
        public int Quantity { get; set; }
        public int List { get; set; }
        public string? Note { get; set; }
        public string? Condition { get; set; }
        public string? Language { get; set; }
        public string? ScryfallId { get; set; }
        public double PriceAcquired { get; set; }
        public string ResolvedName { get; set; } = "";
        public string ResolvedEdition { get; set; } = "";
        public string ResolvedNumber { get; set; } = "";
        public string ResolvedScryfallId { get; set; } = "";
        public bool HasImage { get; set; }
    }

    private class ScryfallCollectionRequest
    {
        [JsonPropertyName("identifiers")]
        public List<ScryfallIdentifier> Identifiers { get; set; } = new();
    }

    private class ScryfallIdentifier
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = "";
    }

    private class ScryfallCollectionResponse
    {
        [JsonPropertyName("data")]
        public List<ScryfallCard> Data { get; set; } = new();
    }

    private class ScryfallCard
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = "";
        [JsonPropertyName("name")]
        public string Name { get; set; } = "";
        [JsonPropertyName("set")]
        public string Set { get; set; } = "";
        [JsonPropertyName("collector_number")]
        public string CollectorNumber { get; set; } = "";
    }

    // ---- OCR result models matching dlensConverter.js's ocrResolveCards()/lookupCardByName() ----

    private class OcrResult
    {
        [JsonPropertyName("cardId")] public int CardId { get; set; }
        [JsonPropertyName("status")] public string Status { get; set; } = "";
        [JsonPropertyName("name")] public string? Name { get; set; }
        [JsonPropertyName("set")] public string? Set { get; set; }
        [JsonPropertyName("collectorNumber")] public string? CollectorNumber { get; set; }
        [JsonPropertyName("scryfallId")] public string? ScryfallId { get; set; }
        [JsonPropertyName("ocrText")] public string? OcrText { get; set; }
        [JsonPropertyName("ocrNameGuess")] public string? OcrNameGuess { get; set; }
        [JsonPropertyName("imageDataUrl")] public string? ImageDataUrl { get; set; }
    }

    private class ScryfallLookupResult
    {
        [JsonPropertyName("name")] public string Name { get; set; } = "";
        [JsonPropertyName("set")] public string Set { get; set; } = "";
        [JsonPropertyName("collectorNumber")] public string CollectorNumber { get; set; } = "";
        [JsonPropertyName("scryfallId")] public string ScryfallId { get; set; } = "";
    }

    private class OcrReviewItem
    {
        public OcrResult Result { get; set; } = new();
        public DlensCard Card { get; set; } = null!;
        public string ManualNameInput { get; set; } = "";
        public string? LookupError { get; set; }
    }
}
