@page "/"
@using MichalMalenda.github.io.Pages
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime



<div class="page-header">
    <button @onclick="ClearCookiesAndRefresh" class="cookie-clear-btn" title="(Ctrl+F5)"></button>
    <input type="text"
           @bind="searchTerm"
           @bind:event="oninput"
           placeholder="Search..."
           class="search-bar"
           @onkeydown="HandleKeyDown" />
</div>

<div class="gallery-container">
    @foreach (var tile in filteredTiles)
    {
        <Tile Title="@tile.Title" Content="@tile.Content" Link="@tile.Link" />
    }
</div>
<div style="margin-top:2rem">
    <SpeedPulse />
</div>


@code {
    private string searchTerm = string.Empty;

    private List<TileData> tiles = new List<TileData>
    {
        new TileData { Title = "2024-01-01", Content = "CV", Link="/about", Tag="CV,Michal Malenda,Michał Malenda,Malenda,Data Science,Experience,School,Education,Download"},
        new TileData { Title = "2024-01-02", Content = "Calculator", Link="/calculator", Tag="Calculator" },
        new TileData { Title = "2024-01-03", Content = "TDEE Calculator", Link="/tdee", Tag="Calculator,Weight Loss,Activity,Total Daily Energy Expenditure,Basal Metabolic Rate,BMR,Harris-Benedict,TDEE"},
        new TileData { Title = "2024-01-04", Content = "Minutes Maker", Link="/minutes-maker", Tag="Meeting,Minutes Maker,Download" },
        new TileData { Title = "2024-01-05", Content = "Text Converter", Link="/converter", Tag="BluePrism,ASCII,UNICODE"},
        new TileData { Title = "2025-08-22", Content = "Companion", Link="/companion", Tag="companion, pet, centipede, fun, game"},
        new TileData { Title = "2025-08-24", Content = "Color Remover", Link="/color-remover", Tag="color, remover, tool, picture, image, edit"},
        new TileData { Title = "2025-08-28", Content = "Pomodoro Timer", Link="/pomodoro-timer", Tag="pomodoro, timer, clock, alarm, learning"},
        new TileData { Title = "2025-01-21", Content = "Tic Tac Toe", Link="/tictactoe", Tag="game, tic, tac, toe, tic tac toe, fun"},
        new TileData { Title = "2027-01-21", Content = "Speed Test", Link="/speedtest", Tag="speed, speedtest, test, speed test, ping, internet"},
        new TileData { Title = "2027-01-21", Content = "WIP", Link="/", Tag="dev"},
        new TileData { Title = "2027-01-21", Content = "WIP", Link="/", Tag="dev"},
        new TileData { Title = "2027-01-21", Content = "WIP", Link="/", Tag="dev"},
        new TileData { Title = "2027-01-21", Content = "WIP", Link="/mtg", Tag="mtg"}
    };

    private IEnumerable<TileData> filteredTiles => tiles.Where(tile =>
        tile.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        tile.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        tile.Tag.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && filteredTiles.Count() == 1)
        {
            var singleTile = filteredTiles.First();
            Navigation.NavigateTo(singleTile.Link);
        }
    }

    private async Task ClearCookiesAndRefresh()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            document.cookie.split(';').forEach(function(c) {
                document.cookie = c.replace(/^ +/, '').replace(/=.*/, '=;expires=' + new Date().toUTCString() + ';path=/');
            });
            if (typeof(Storage) !== 'undefined') {
                localStorage.clear();
                sessionStorage.clear();
            }
            location.reload(true);
        ");
    }

    private class TileData
    {
        public string Title { get; set; }
        public string Content { get; set; }
        public string Link { get; set; }
        public string Tag { get; set; }
    }
}